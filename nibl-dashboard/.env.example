# Odoo Connection — Add these to Vercel Environment Variables
ODOO_URL=https://odoo.niblfoods.com
ODOO_DB=nibl-foods-production
ODOO_USERNAME=saqib@niblfoods.com
ODOO_API_KEY=your-odoo-api-key

# ClickUp API Integration
CLICKUP_API_TOKEN=your-clickup-personal-access-token-here

# Claude AI (Anthropic) — required for AI Reports + Assistant tabs
ANTHROPIC_API_KEY=your-value-here

# Vercel KV — auto-populated when you connect a KV store in Vercel dashboard
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
